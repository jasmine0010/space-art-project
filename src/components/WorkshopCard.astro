---
import { getEntry } from 'astro:content';
import Doodle from './Doodle.astro';
import AccentText from './AccentText.astro';
const { full = false } = Astro.props;
const { data: workshop } = (await getEntry('workshop', 'first'))!;
---

<section class="workshop" aria-labelledby="workshop-heading">
  <div class="workshop-picture" aria-hidden="true">
    <div class="workshop-paper">
      <span>K–5 WORKSHOP</span>
      <Doodle kind="planet" />
      <span class="paper-note">planets & exoplanets</span>
    </div>
    <Doodle kind="star" class="workshop-star" />
    <span class="tape"></span>
  </div>
  <div class="workshop-copy">
    <span class="status">First workshop · {workshop.status}</span>
    <h2 id="workshop-heading">
      <AccentText text={workshop.title} word="exoplanets" />
    </h2>
    <p>{workshop.description}</p>
    <ul class="workshop-facts">
      <li>{workshop.audience}</li>
      <li>{workshop.duration}</li>
    </ul>
    <p class="workshop-note">{workshop.locationNote}</p>
    {full ? (
      <p class="registration-note">{workshop.registrationNote}</p>
    ) : (
      <a class="text-link" href="/reach-out/">
        Workshop details <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>
</section>
